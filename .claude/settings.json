{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Grep(*)",
      "Glob(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(git push * test)",
      "Bash(git push * test:*)",
      "Bash(git push * *:test)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * *:main)",
      "Bash(git push * master)",
      "Bash(git push * master:*)",
      "Bash(git push * *:master)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push --delete *)",
      "Bash(git reset --hard origin/test*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git reset --hard origin/master*)",
      "Bash(gh pr merge * --base test*)",
      "Bash(gh pr merge * --base main*)",
      "Bash(gh pr merge * --base master*)",
      "Bash(gh release create *)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr ~*)"
    ]
  }
}
